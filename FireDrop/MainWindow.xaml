<Window x:Class="FireDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FireDrop.Controls"
        Title="FireDrop — приём файлов"
        Width="1180" Height="860" MinWidth="1060" MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#070C16"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#18253A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!-- Ambient background -->
            <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Border Background="{StaticResource AppBackgroundBrush}" />
                <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-360,-470,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3422D3EE" Offset="0" />
                            <GradientStop Color="#0F22D3EE" Offset="0.5" />
                            <GradientStop Color="#0022D3EE" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-300,-400">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#308B5CF6" Offset="0" />
                            <GradientStop Color="#0C8B5CF6" Offset="0.55" />
                            <GradientStop Color="#008B5CF6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-330,-80,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#181F6FEB" Offset="0" />
                            <GradientStop Color="#001F6FEB" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ================= Title bar ================= -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="#070C16"
                    BorderBrush="#152137" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource LogoGradientBrush}">
                            <Viewbox Width="21" Height="21">
                                <Path Data="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"
                                      Stroke="#06131D" StrokeThickness="2.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FireDrop" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="с телефона на компьютер" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" CornerRadius="20" Padding="11,6"
                                Background="{StaticResource SuccessSoftBrush}"
                                BorderBrush="#4034D399" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="StatusText" Text="Запуск сервера…" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Height="22" Background="#1A2942" Margin="14,0,10,0" />

                        <Button x:Name="SendToPhoneButton" Style="{StaticResource IconButtonStyle}"
                                Click="SendToPhoneButton_Click" ToolTip="Отправить на телефон"
                                AutomationProperties.Name="Отправить на телефон">
                            <Path Data="M2 11l17-8-8 17-2.5-6.5z" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>

                        <Button x:Name="AboutButton" Style="{StaticResource IconButtonStyle}"
                                Click="AboutButton_Click" ToolTip="О приложении"
                                AutomationProperties.Name="О приложении">
                            <Path Data="M9 2.9a6.1 6.1 0 1 0 0 12.2A6.1 6.1 0 0 0 9 2.9zM9 5.6v.03M9 7.9v4.3"
                                  Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>

                        <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}"
                                Click="SettingsButton_Click" ToolTip="Настройки"
                                AutomationProperties.Name="Настройки">
                            <Grid Width="18" Height="18">
                                <Path Data="M1 5.5H17 M1 12.5H17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Width="6" Height="6" Fill="#070C16"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.6"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,2.5,0,0" />
                                <Ellipse Width="6" Height="6" Fill="#070C16"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.6"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,9.5,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Click="Minimize_Click" ToolTip="Свернуть"
                                AutomationProperties.Name="Свернуть окно">
                            <Path Data="M4 12h16" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>

                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Click="Maximize_Click" ToolTip="Развернуть"
                                AutomationProperties.Name="Развернуть окно">
                            <Path x:Name="MaximizeIcon" Data="M4 4h16v16H4z" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" />
                        </Button>

                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                                Click="CloseWindow_Click" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть FireDrop">
                            <Path Data="M5 5l14 14M19 5 5 19" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Content ================= -->
            <Grid x:Name="MainContent" Grid.Row="1" Margin="34,10,34,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H1Style}" Text="Файлы с телефона — сразу на компьютер" />
                        <TextBlock Style="{StaticResource BodyMutedStyle}" Margin="0,5,0,0"
                                   Text="Без облака, кабелей и сжатия. Наведите камеру телефона на QR-код — и выбирайте файлы." />
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#0C1829" BorderBrush="#1D2E48" BorderThickness="1"
                            CornerRadius="20" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5 12.5l4 4 10-10" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Только ваша локальная сеть" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="402" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= QR card ================= -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22,20,22,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="252" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="13" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                    <Border Background="#17253B" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="ТЕЛЕФОН → ПК" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="QrLiveDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="QrLiveText" Text="онлайн" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" HorizontalAlignment="Center">
                                <Border Width="252" Height="252" CornerRadius="18" Background="#FFFFFF" Padding="8">
                                    <controls:QrImage x:Name="QrCodeImage"
                                                      AutomationProperties.Name="QR-код для подключения телефона" />
                                </Border>

                                <Border x:Name="QrStatePanel" Width="252" Height="252" CornerRadius="18"
                                        Background="#0A1525" BorderBrush="#22344F" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,0">
                                        <Border Width="42" Height="42" CornerRadius="13" Background="#24FB7185"
                                                HorizontalAlignment="Center">
                                            <Path Data="M12 4 2.8 20h18.4L12 4Zm0 6v5m0 3v.4" Width="18" Height="18"
                                                  Stretch="Uniform" Stroke="{StaticResource DangerBrush}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                        <TextBlock x:Name="QrStateTitle" Text="Сервер не запущен"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                                        <TextBlock x:Name="QrStateText" Text="Проверьте настройки и попробуйте снова."
                                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   LineHeight="16" Margin="0,6,0,0" />
                                        <Button x:Name="QrStateAction" Style="{StaticResource SmallSecondaryButtonStyle}"
                                                Content="Повторить" HorizontalAlignment="Center"
                                                Margin="0,13,0,0" Click="QrStateAction_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Наведите камеру телефона" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="{StaticResource DisplayFont}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="QR-код откроет страницу приёма. Код доступа уже внутри ссылки."
                                           Style="{StaticResource BodyMutedStyle}" FontSize="11.5"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Row="6" Height="40" Background="#0A1422"
                                    BorderBrush="#1D2D47" BorderThickness="1" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UrlText" Text="http://—"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyLinkButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                            Width="32" Height="32" Margin="0,0,4,0"
                                            Click="CopyLink_Click" ToolTip="Скопировать ссылку с доступом"
                                            AutomationProperties.Name="Скопировать ссылку для телефона">
                                        <Path Data="M9 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h1"
                                              Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="8" Height="1" Background="#17253B" />

                            <Grid Grid.Row="10">
                                <TextBlock Text="Или введите код на телефоне" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="CopyPinButton" Style="{StaticResource TextButtonStyle}"
                                        Content="Скопировать" Padding="6,2" HorizontalAlignment="Right"
                                        Click="CopyPin_Click" FontSize="10.5"
                                        AutomationProperties.Name="Скопировать код доступа" />
                            </Grid>

                            <ItemsControl x:Name="PinItems" Grid.Row="12" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PinBoxStyle}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="14" Background="#0B1A2B" BorderBrush="#1A3044"
                                    BorderThickness="1" CornerRadius="12" Padding="11,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" Width="13" Height="13"
                                          Stretch="Uniform" Fill="{StaticResource WarningBrush}"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Margin="9,0,0,0" FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="15"
                                               Text="Для максимальной скорости держите телефон рядом с роутером и выбирайте сеть 5 ГГц." />
                                </Grid>
                            </Border>

                            <Button x:Name="AddressButton" Grid.Row="16" Style="{StaticResource AddressButtonStyle}"
                                    Margin="-9,0,-9,0" Click="AddressButton_Click"
                                    ToolTip="Выбрать сетевой адрес"
                                    AutomationProperties.Name="Сетевой адрес для подключения">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M4 9.5a12 12 0 0 1 16 0M7 13a8 8 0 0 1 10 0M10 16.5a3.5 3.5 0 0 1 4 0"
                                          Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AddressText" Grid.Column="1" Text="Поиск сети…"
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="7,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path Grid.Column="2" Data="M6 9l6 6 6-6" Width="10" Height="10"
                                          Stretch="Uniform" Stroke="{StaticResource TextDimBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ================= Right column ================= -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Height="86" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="СКОРОСТЬ" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                        <TextBlock x:Name="SpeedValueText" Text="0 МБ/с"
                                                   Style="{StaticResource StatValueStyle}" Margin="0,3,0,0" />
                                        <TextBlock x:Name="SpeedHintText" Text="ожидание"
                                                   Style="{StaticResource SmallMutedStyle}" FontSize="9.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="9"
                                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <Path Data="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" Width="14" Height="14"
                                              Stretch="Uniform" Fill="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" CornerRadius="16" Height="86" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ПРИНЯТО" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                        <TextBlock x:Name="FilesValueText" Text="0"
                                                   Style="{StaticResource StatValueStyle}" Margin="0,3,0,0" />
                                        <TextBlock Text="файлов за сеанс" Style="{StaticResource SmallMutedStyle}"
                                                   FontSize="9.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="9"
                                            Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Top">
                                        <Path Data="M4 12.5l5 5L20 6.5" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" CornerRadius="16" Height="86" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ОБЪЁМ" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                        <TextBlock x:Name="VolumeValueText" Text="0 Б"
                                                   Style="{StaticResource StatValueStyle}" Margin="0,3,0,0" />
                                        <TextBlock Text="за этот сеанс" Style="{StaticResource SmallMutedStyle}"
                                                   FontSize="9.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="9"
                                            Background="{StaticResource AccentVioletSoftBrush}" VerticalAlignment="Top">
                                        <Path Data="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Zm0 0 8 4.5M12 3 4 7.5m8-4.5v18m8-13.5-8 4.5-8-4.5"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{StaticResource AccentVioletBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" CornerRadius="16" Height="80" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="11" Background="#1F22D3EE"
                                        VerticalAlignment="Center">
                                    <Path Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"
                                          Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="ПАПКА СОХРАНЕНИЯ" Style="{StaticResource SectionLabelStyle}" FontSize="8.5" />
                                    <TextBlock x:Name="FolderPathText" Text="Загрузки\FireDrop"
                                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="OpenFolderButton" Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Content="Открыть" Click="OpenFolder_Click" />
                                    <Button x:Name="ChangeFolderButton" Style="{StaticResource TextButtonStyle}"
                                            Content="Изменить" Click="ChangeFolder_Click" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="20,14,14,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Принятые файлы" Style="{StaticResource H2Style}" VerticalAlignment="Center" />
                                        <Border Background="#16253C" CornerRadius="7" Padding="7,1.5" Margin="9,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="FilesCountBadge" Text="0" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Button x:Name="ClearButton" Style="{StaticResource TextButtonStyle}"
                                            Content="Очистить" HorizontalAlignment="Right" Click="ClearFiles_Click" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="8,0,4,8">
                                    <ListBox x:Name="FilesList" Style="{StaticResource FileListStyle}"
                                             MouseDoubleClick="FilesList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="62" ToolTip="{Binding Tooltip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="11" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="38" Height="38" CornerRadius="11"
                                                            Background="{Binding IconBackground}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExtensionText}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="{Binding IconForeground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <Grid Grid.Column="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SpeedText}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding ProgressBrush}"
                                                                       Margin="12,0,0,0" MaxWidth="142"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding SpeedText}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                <Run Text="  ·  " />
                                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                                                       FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>

                                                        <ProgressBar Grid.Row="2" Style="{StaticResource SlimProgressBarStyle}"
                                                                     Value="{Binding Progress, Mode=OneWay}"
                                                                     Foreground="{Binding ProgressBrush, Mode=OneWay}"
                                                                     Margin="0,7,0,0" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid x:Name="EmptyState" IsHitTestVisible="False">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18">
                                            <Border Width="54" Height="54" CornerRadius="18" Background="#132339"
                                                    HorizontalAlignment="Center">
                                                <Path Data="M12 5v10m0 0-4-4m4 4 4-4M6 19h12" Width="20" Height="20"
                                                      Stretch="Uniform" Stroke="{StaticResource TextDimBrush}"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Border>
                                            <TextBlock Text="Пока пусто" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,11,0,0" />
                                            <TextBlock Text="Отправьте файл с телефона — он появится здесь."
                                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= Footer ================= -->
            <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="#131F33" BorderThickness="0,1,0,0">
                <Grid Margin="34,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="FooterStateDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="FooterStateText" Text="Сервер работает"
                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Text="FireDrop 1.2.3 · только локальная сеть"
                               FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ================= Settings overlay ================= -->
            <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Panel.ZIndex="50" Visibility="Collapsed"
                  Background="#D4060A12" MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
                <Border x:Name="SettingsCard" Width="580" MaxHeight="700"
                        Background="#0B1525" BorderBrush="#243653" BorderThickness="1"
                        CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Effect="{StaticResource ModalShadow}" RenderTransformOrigin="0.5,0.5"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SettingsCardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="26,20,16,12">
                            <StackPanel>
                                <TextBlock Text="Настройки" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Имя, папка и параметры сети" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="CloseSettingsButton" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="CloseSettings_Click" ToolTip="Закрыть"
                                    AutomationProperties.Name="Закрыть настройки">
                                <Path Data="M5 5l14 14M19 5 5 19" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,18,0">
                            <StackPanel Margin="0,4,8,10">
                                <TextBlock Text="ИМЯ КОМПЬЮТЕРА" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                <TextBox x:Name="DeviceNameBox" Style="{StaticResource TextBoxStyle}"
                                         Margin="0,6,0,0" MaxLength="40"
                                         AutomationProperties.Name="Имя компьютера" />
                                <TextBlock Text="Так компьютер называется на странице телефона."
                                           Style="{StaticResource SmallMutedStyle}" Margin="0,5,0,0" />

                                <TextBlock Text="ПАПКА СОХРАНЕНИЯ" Style="{StaticResource SectionLabelStyle}"
                                           FontSize="9" Margin="0,16,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SaveFolderBox" Style="{StaticResource TextBoxStyle}"
                                             AutomationProperties.Name="Папка сохранения" />
                                    <Button Grid.Column="2" Content="Обзор…" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="40" Width="88" Click="BrowseFolder_Click"
                                            AutomationProperties.Name="Выбрать папку сохранения" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ПОРТ" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                        <TextBox x:Name="PortBox" Style="{StaticResource TextBoxStyle}"
                                                 Margin="0,6,0,0" MaxLength="5"
                                                 PreviewTextInput="PortBox_PreviewTextInput"
                                                 DataObject.Pasting="PortBox_OnPaste"
                                                 AutomationProperties.Name="Порт сервера" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <TextBlock Text="От 1024 до 65535. Если порт занят другой программой, выберите свободный."
                                                   Style="{StaticResource SmallMutedStyle}" TextWrapping="Wrap" LineHeight="15" />
                                        <TextBlock x:Name="CurrentPortText" Text="Сейчас используется порт 47820"
                                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="AutostartCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,20,0,0"
                                          AutomationProperties.Name="Запускать при входе в Windows">
                                    <StackPanel>
                                        <TextBlock Text="Запускать при входе в Windows" FontSize="12.5" />
                                        <TextBlock Text="FireDrop будет готов принимать файлы сразу после включения компьютера."
                                                   Style="{StaticResource SmallMutedStyle}" FontSize="10.5"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="TrayCheck" Style="{StaticResource CheckBoxStyle}" Margin="0,14,0,0"
                                          AutomationProperties.Name="Сворачивать в трей при закрытии">
                                    <StackPanel>
                                        <TextBlock Text="Сворачивать в трей при закрытии" FontSize="12.5" />
                                        <TextBlock Text="Приём файлов продолжится, даже когда окно скрыто."
                                                   Style="{StaticResource SmallMutedStyle}" FontSize="10.5"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>

                                <Border Background="#0D1B2C" BorderBrush="#1A2C45" BorderThickness="1"
                                        CornerRadius="11" Padding="14,12" Margin="0,20,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5.5 10.5A4.5 4.5 0 0 1 5.5 1.5M12.5 1.5a4.5 4.5 0 0 1 0 9m-3.5-1v4.5M6 14h6"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock Text="Брандмауэр Windows" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="FirewallStatusText"
                                                   Text="Проверяем правила…"
                                                   FontSize="10.5" LineHeight="15" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,6,0,0" />
                                        <Button x:Name="FirewallButton" Content="Разрешить FireDrop в сети"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="34"
                                                Padding="14,0" HorizontalAlignment="Left" Margin="0,9,0,0"
                                                Click="FirewallButton_Click"
                                                AutomationProperties.Name="Разрешить FireDrop в брандмауэре" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#0D1B2C" BorderBrush="#1A2C45" BorderThickness="1"
                                        CornerRadius="11" Padding="11,9" Margin="0,20,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 8v5m0 3.5v.5M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Margin="9,0,0,0" FontSize="10.5" LineHeight="15"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                   Text="После смены порта сервер перезапустится, а ссылка и QR-код обновятся автоматически." />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="SettingsError" Foreground="{StaticResource DangerBrush}"
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                           Margin="0,12,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="#192942" BorderThickness="0,1,0,0" Padding="26,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                                        Width="92" Click="CloseSettings_Click" />
                                <Button x:Name="SaveSettingsButton" Content="Сохранить"
                                        Style="{StaticResource PrimaryButtonStyle}" Width="124"
                                        Margin="10,0,0,0" Click="SaveSettings_Click"
                                        AutomationProperties.Name="Сохранить настройки" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= About overlay ================= -->
            <Grid x:Name="AboutOverlay" Grid.RowSpan="3" Panel.ZIndex="65" Visibility="Collapsed"
                  Background="#D4060A12" MouseLeftButtonDown="AboutOverlay_MouseLeftButtonDown">
                <Border x:Name="AboutCard" Width="560" MaxHeight="680"
                        Background="#0B1525" BorderBrush="#243653" BorderThickness="1"
                        CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Effect="{StaticResource ModalShadow}" RenderTransformOrigin="0.5,0.5"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="AboutCardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="26,20,16,12">
                            <StackPanel>
                                <TextBlock Text="О приложении" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="AboutVersionText" Text="FireDrop 1.2.3"
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="CloseAbout_Click" ToolTip="Закрыть"
                                    AutomationProperties.Name="Закрыть страницу приложения">
                                <Path Data="M5 5l14 14M19 5 5 19" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,18,0">
                            <StackPanel Margin="0,4,8,10">
                                <TextBlock Text="Что такое FireDrop"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Быстрый обмен файлами и целыми папками по локальной Wi-Fi сети: с компьютера на телефон, с телефона на компьютер и с телефона на телефон. Работает без интернета, облака и регистрации — достаточно, чтобы устройства были в одной сети."
                                           FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />

                                <TextBlock Text="Главное"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,0" />
                                <StackPanel x:Name="AboutFacts">
                                    <TextBlock Text="• Папки передаются целиком, структура вложенных папок сохраняется."
                                               FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" />
                                    <TextBlock Text="• Скорость ограничена только вашей Wi-Fi сетью: до 30 MB/s и выше, без облака в пути."
                                               FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" />
                                    <TextBlock Text="• Подключение — по QR-коду или шестизначному коду; данные не выходят за пределы сети."
                                               FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" />
                                    <TextBlock Text="• Приём без перезаписи: повторные файлы сохраняются рядом с номером (1), (2)…"
                                               FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" />
                                </StackPanel>

                                <TextBlock Text="Вопросы или идеи?"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,0" />
                                <TextBlock Text="Автор приложения — @LoioshS. Напишите в Telegram: приложение локальное, но обратная связь обычно спасает следующий выпуск."
                                           FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="#192942" BorderThickness="0,1,0,0" Padding="26,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Написать автору · Telegram"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="40"
                                        Click="OpenAuthorTelegram_Click"
                                        AutomationProperties.Name="Открыть Telegram автора @LoioshS" />
                                <Button Content="Понятно"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="40" Width="110"
                                        Margin="10,0,0,0" Click="CloseAbout_Click"
                                        AutomationProperties.Name="Закрыть страницу приложения" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Send-to-phone overlay ================= -->
            <Grid x:Name="SendOverlay" Grid.RowSpan="3" Panel.ZIndex="60" Visibility="Collapsed"
                  Background="#D4060A12" MouseLeftButtonDown="SendOverlay_MouseLeftButtonDown">
                <Border x:Name="SendCard" Width="640" MaxHeight="780"
                        Background="#0B1525" BorderBrush="#243653" BorderThickness="1"
                        CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Effect="{StaticResource ModalShadow}" RenderTransformOrigin="0.5,0.5"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SendCardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="26,20,16,12">
                            <StackPanel>
                                <TextBlock Text="Отправить на телефон" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Файлы и папки с компьютера — в FireDrop на телефоне"
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="CloseSend_Click" ToolTip="Закрыть"
                                    AutomationProperties.Name="Закрыть отправку">
                                <Path Data="M5 5l14 14M19 5 5 19" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,18,0">
                            <StackPanel Margin="0,4,8,10">
                                <TextBlock Text="ПОЛУЧАТЕЛЬ" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SendAddressBox" Style="{StaticResource TextBoxStyle}"
                                             MaxLength="160" TextChanged="SendAddressBox_TextChanged"
                                             AutomationProperties.Name="Адрес получателя" />
                                    <Button Grid.Column="2" x:Name="FindDevicesButton" Content="Найти рядом"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Width="112"
                                            Click="FindDevicesAsync_Click" MinWidth="112"
                                            AutomationProperties.Name="Найти устройства рядом" />
                                </Grid>
                                <TextBlock Text="IP и порт из QR-кода получателя. Можно вставить код целиком — адрес подставится сам."
                                           Style="{StaticResource SmallMutedStyle}" Margin="0,5,0,0" />
                                <ItemsControl x:Name="SendDevicesList" Margin="0,10,0,0" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                                    HorizontalContentAlignment="Left" Click="SendDevice_Click"
                                                    AutomationProperties.Name="{Binding SelectName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Mark}" Foreground="{StaticResource AccentBrush}"
                                                               FontSize="12" FontWeight="Bold" Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding EndpointLabel}" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SendFoundLabel" Style="{StaticResource SmallMutedStyle}"
                                           Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

                                <Border x:Name="SendFirewallCard" Background="#231b2c0d" BorderBrush="#4Dfbbf24"
                                        BorderThickness="1" CornerRadius="11" Padding="12,10"
                                        Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Пустой список часто означает, что Windows блокирует FireDrop для нового файла программы."
                                                   FontSize="10.5" LineHeight="15" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <Button x:Name="SendFirewallButton" Content="Разрешить FireDrop в брандмауэре"
                                                Style="{StaticResource SmallSecondaryButtonStyle}" Height="32"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Click="FirewallButton_Click"
                                                AutomationProperties.Name="Разрешить FireDrop в брандмауэре" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="КОД ПРИЁМА" Style="{StaticResource SectionLabelStyle}" FontSize="9" />
                                        <TextBox x:Name="SendPinBox" Style="{StaticResource TextBoxStyle}"
                                                 Margin="0,6,0,0" MaxLength="6"
                                                 PreviewTextInput="SendPinBox_PreviewTextInput"
                                                 DataObject.Pasting="SendPinBox_OnPaste"
                                                 AutomationProperties.Name="Код приёма получателя" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <TextBlock Text="Шесть цифр с экрана получателя. Если вставили код с QR — он уже заполнен."
                                                   Style="{StaticResource SmallMutedStyle}" TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="SendTargetStatus" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,12,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="ЧТО ОТПРАВИТЬ" Style="{StaticResource SectionLabelStyle}"
                                           FontSize="9" Margin="0,18,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="PickSendFilesButton" Content="Файлы…"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="36" Width="102"
                                            Click="PickSendFiles_Click" MinWidth="102"
                                            AutomationProperties.Name="Выбрать файлы для отправки" />
                                    <Button x:Name="PickSendFolderButton" Content="Папка…"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="36" Width="102"
                                            Margin="10,0,0,0" Click="PickSendFolder_Click" MinWidth="102"
                                            AutomationProperties.Name="Выбрать папку для отправки" />
                                    <Button x:Name="SendClearButton" Content="Очистить"
                                            Style="{StaticResource TextButtonStyle}" Margin="10,0,0,0"
                                            Click="SendClear_Click" AutomationProperties.Name="Очистить список" />
                                </StackPanel>

                                <Border x:Name="SendFilesCard" Background="#0D1B2C" BorderBrush="#1A2C45"
                                        BorderThickness="1" CornerRadius="11" Margin="0,10,0,0"
                                        Padding="12,8" Visibility="Collapsed">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="SendFilesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="StateText" Grid.Column="2"
                                                                   Text="{Binding StateText}" FontSize="10.5"
                                                                   Foreground="{Binding StateBrush}" Margin="12,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock x:Name="SendQueueText" Style="{StaticResource SmallMutedStyle}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Пока ничего не выбрано." />

                                <TextBlock x:Name="SendError" Foreground="{StaticResource DangerBrush}"
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                           Margin="0,12,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="#192942" BorderThickness="0,1,0,0" Padding="26,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="SendProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="SendProgressTitle" Text="Отправляем…" FontSize="11.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="SendProgressBar" Style="{StaticResource SlimProgressBarStyle}"
                                                 Margin="0,6,22,0" />
                                    <TextBlock x:Name="SendProgressHint" Text="" FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}" Margin="0,4,22,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SendCancelButton" Content="Отмена"
                                            Style="{StaticResource SecondaryButtonStyle}" Width="92" MinWidth="92"
                                            Click="SendCancel_Click" Visibility="Collapsed"
                                            AutomationProperties.Name="Отменить передачу" />
                                    <Button x:Name="SendActionButton" Content="Отправить"
                                            Style="{StaticResource PrimaryButtonStyle}" Width="124" MinWidth="124"
                                            Margin="10,0,0,0" Click="SendAction_Click"
                                            AutomationProperties.Name="Отправить выбранные файлы" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Toast ================= -->
            <Border x:Name="Toast" Grid.RowSpan="3" Panel.ZIndex="80" Visibility="Collapsed"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,54"
                    MaxWidth="640" Background="#102A22" BorderBrush="#2A6B53" BorderThickness="1"
                    CornerRadius="12" Padding="12,10"
                    AutomationProperties.LiveSetting="Assertive">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10"
                                      Direction="270" Opacity="0.55" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ToastIconHost" Width="26" Height="26" CornerRadius="8"
                            Background="#1B5A45" VerticalAlignment="Center">
                        <Path x:Name="ToastIcon" Data="M4 12.5l5 5L20 6.5" Width="13" Height="13"
                              Stretch="Uniform" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="ToastText" Text="Готово" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

